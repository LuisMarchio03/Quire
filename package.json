{
  "name": "quire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Seu acervo, lido do seu jeito — leitor pessoal de EPUB e PDF.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node --experimental-strip-types --env-file=.env.local scripts/setup-db.ts",
    "hash-password": "node --experimental-strip-types scripts/hash-password.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
